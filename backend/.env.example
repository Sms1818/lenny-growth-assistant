APP_NAME="Lenny Growth Assistant"
ENVIRONMENT=development

# Local development database.
# Docker Compose overrides this to use the postgres service hostname.
DATABASE_URL=postgresql+asyncpg://lenny:lenny_dev@localhost:5433/lenny_growth

# Local Ollama runtime.
OLLAMA_BASE_URL=http://localhost:11434

# Local conversational generation model.
AGENT_PROVIDER=ollama
AGENT_MODEL=llama3.2:3b
AGENT_TIMEOUT_SECONDS=120

# Retrieval embeddings are generated locally through Ollama.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Local model used when artifact generation is explicitly set to Local.
ARTIFACT_MODEL=qwen3:4b-instruct
ARTIFACT_TIMEOUT_SECONDS=300

# Cloud generation.
# Auto mode uses cloud directly for Markdown, HTML, and Ship 30 artifacts.
# Cloud mode also uses these settings.
CLOUD_PROVIDER=openai
CLOUD_MODEL=gpt-5.4-mini

# Optional Auto-chat fallback:
# true  = if local chat generation fails, try the configured cloud provider.
# false = Auto chat remains local-only.
CLOUD_FALLBACK_ENABLED=false

# Required for Cloud mode, Auto artifact generation,
# and Auto-chat fallback when enabled.
# Never commit a real API key.
OPENAI_API_KEY=

# Pi is currently used for cloud model execution.
AGENT_EXECUTABLE=pi
