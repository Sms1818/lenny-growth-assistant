APP_NAME="Lenny Growth Assistant"
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://lenny:lenny_dev@localhost:5433/lenny_growth

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Default agent configuration.
# The submitted demo uses Ollama locally through Pi Coding Agent.
AGENT_PROVIDER=ollama
AGENT_MODEL=llama3.2:3b
AGENT_EXECUTABLE=pi
AGENT_TIMEOUT_SECONDS=120

# Optional cloud provider configuration.
CLOUD_PROVIDER=openai
CLOUD_MODEL=gpt-5.4-mini
CLOUD_FALLBACK_ENABLED=false

# Required when using OpenAI.
# Never commit a real API key.
OPENAI_API_KEY=